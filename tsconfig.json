{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "noEmit": true,
    "paths": {
      "@shiri/calendar-core": [
        "./packages/calendar-core/src/index.ts"
      ],
      "@shiri/calendar-core/data": [
        "./packages/calendar-core/src/data.ts"
      ],
      "@shiri/calendar-ui": [
        "./packages/calendar-ui/src/index.ts"
      ]
    },
    "jsx": "react-jsx"
  },
  "include": [
    "scripts/**/*.ts",
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.tsx",
    "apps/calendar/src/**/*.ts",
    "apps/calendar/src/**/*.tsx",
    "apps/calendar/vite.config.ts",
    "tailwind.config.ts"
  ]
}
