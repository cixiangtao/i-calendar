{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "noEmit": true,
    "paths": {
      "@i-calendar/core": ["./packages/calendar-core/src/index.ts"],
      "@i-calendar/core/data": ["./packages/calendar-core/src/data.ts"],
      "@i-calendar/ui": ["./packages/calendar-ui/src/index.ts"]
    },
    "jsx": "react-jsx"
  },
  "include": [
    "scripts/**/*.ts",
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.tsx",
    "apps/calendar/src/**/*.ts",
    "apps/calendar/src/**/*.tsx",
    "apps/calendar/vite.config.ts",
    "tailwind.config.ts"
  ]
}
