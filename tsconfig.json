{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "noEmit": true,
    "paths": {
      "@shiri/calendar-core": [
        "./packages/calendar-core/src/index.ts"
      ]
    }
  },
  "include": [
    "scripts/**/*.ts",
    "packages/calendar-core/src/**/*.ts"
  ]
}
