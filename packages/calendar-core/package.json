{
  "name": "@i-calendar/core",
  "version": "1.3.0",
  "description": "与 UI 和平台无关的中国农历、节气和放假调休查询核心",
  "license": "MIT",
  "files": [
    "dist",
    "src/data/*.json",
    "src/data/LICENSE-holiday-cn",
    "src/data/LICENSE-geonames",
    "LICENSE-lunar-typescript",
    "LICENSE-suncalc",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./data": {
      "types": "./dist/data.d.ts",
      "import": "./dist/data.js"
    },
    "./places": {
      "types": "./dist/places.d.ts",
      "import": "./dist/places.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/bundle-core.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "lunar-typescript": "1.8.7",
    "suncalc": "2.1.1"
  }
}
