      "css": ".ds-nav{display:flex;align-items:center;gap:4px}.ds-nav button{position:relative;isolation:isolate;display:grid;place-items:center;width:28px;height:28px;padding:0;border:0;border-radius:8px;background:transparent;color:var(--ink,#171b24);cursor:pointer}.ds-nav button:before{content:\"\";position:absolute;top:50%;left:50%;width:28px;height:28px;transform:translate(-50%,-50%);border-radius:8px;background:var(--control,#f4f5f8);z-index:-1}.ds-nav .ds-nav-month{display:inline-flex;justify-content:space-between;width:50px;padding:0 4px;font:500 13px/20px -apple-system,BlinkMacSystemFont,\"PingFang SC\",sans-serif}.ds-nav .ds-nav-month:before{width:100%}.ds-nav-month svg{width:10px;height:10px;fill:none;stroke:currentColor;stroke-width:1.7}.ds-nav button:focus-visible{outline:2px solid var(--blue,#3269d9);outline-offset:3px}.ds-nav .ds-nav-month:focus-visible{outline:1px solid var(--secondary,#5b6575);outline-offset:1px}.ds-nav button:disabled{opacity:.38}@media(pointer:coarse){.ds-nav{gap:2px}.ds-nav button{width:44px;height:44px}}"
