      "html": "<nav class=\"ds-nav\" aria-label=\"切换月份\"><button aria-label=\"上个月\"><svg width=\"13\" height=\"13\" viewBox=\"0 0 16 16\" fill=\"none\"><path d=\"m10 3-5 5 5 5\" stroke=\"currentColor\" stroke-width=\"1.5\"/></svg></button><button class=\"ds-nav-month\" aria-label=\"月份\" aria-haspopup=\"listbox\">11月<svg viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"m4 6 4 4 4-4\"/></svg></button><button aria-label=\"下个月\"><svg width=\"13\" height=\"13\" viewBox=\"0 0 16 16\" fill=\"none\"><path d=\"m6 3 5 5-5 5\" stroke=\"currentColor\" stroke-width=\"1.5\"/></svg></button></nav>",
