  "narrative": {
    "northStar": "随手翻开的松绿小月历",
    "overview": "沿用用户确认的 A“月历优先”方向，以公农历双行、松绿选择态和轻量休班标记组织信息。日历保持紧凑，设置在同一界面内进入与返回。\n\n视觉规范由共享 React 界面与 CSS 实现，Mac 使用 Tauri 的系统 WebView。Web 采用相同月历，介绍位于首屏之后。iOS 复用该实现并处理安全区域与触控尺寸，尚未在模拟器或真机验证。",
    "keyCharacteristics": [
      "系统字体、清晰的公农历层级和固定七列六周。",
      "松绿组织选择和节气，红色提示休息日，赭色提示补班。",
      "今日描边、选中填充和休班文字各自表达事实。",
      "调休未知状态直接写明，来源在设置中可查。"
    ],
    "rules": [
      {
        "name": "The Selection Rule",
        "body": "选中的实心背景、今天的细描边、休班的文字标记分别表达不同事实，不能互相替代。",
        "section": "colors"
      }
    ],
    "dos": [
      "**Do** 保持七列六周和公农历双行的稳定布局。",
      "**Do** 将今日、选中和休班状态分别表达。",
      "**Do** 明确标出未收录年份，并保留来源入口。",
      "**Do** 让官网首屏可以直接查日期。"
    ],
    "donts": [
      "**Don't** 将普通周末解释为已确认的法定放假。",
      "**Don't** 在首屏加入宣传、下载或注册流程。",
      "**Don't** 将手机浏览器截图写成 iOS 设备验证。",
      "**Don't** 重新维护 SwiftUI 或另一套跨平台日历界面。"
    ]
  }
