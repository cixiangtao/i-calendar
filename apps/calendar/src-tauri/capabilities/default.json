{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "calendar-main",
  "description": "日历主界面的基础能力、复制日期和打开 HTTPS 来源链接",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "clipboard-manager:allow-write-text",
    { "identifier": "opener:allow-open-url", "allow": [{ "url": "https://*" }] }
  ]
}
