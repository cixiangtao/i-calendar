{
  "$schema": "https://unpkg.com/release-it@21.1.2/schema/release-it.json",
  "git": {
    "requireBranch": "main",
    "requireCleanWorkingDir": false,
    "requireUpstream": true,
    "requireCommits": true,
    "addUntrackedFiles": false,
    "commitMessage": "chore(release): 🔨 发布 ${version} 正式版",
    "tagName": "v${version}",
    "tagAnnotation": "i日历 ${version} 正式版",
    "push": false
  },
  "npm": false,
  "github": { "release": false },
  "gitlab": { "release": false },
  "plugins": { "./scripts/release-version-plugin.mjs": {} },
  "hooks": {
    "before:init": "node scripts/release-version.mjs guard",
    "before:bump": "node scripts/release-version.mjs validate ${version}",
    "after:bump": [
      "pnpm run check",
      "pnpm run check:native",
      "pnpm run build:mac",
      "pnpm run check:mac"
    ],
    "before:git:release": "node scripts/release-version.mjs verify ${version}",
    "after:release": "git push --atomic origin HEAD:refs/heads/main refs/tags/v${version}:refs/tags/v${version}"
  }
}
