{
  "name": "shiri-calendar",
  "displayName": "i日历",
  "version": "0.1.0",
  "private": true,
  "description": "i日历：免费无广告的菜单栏日历，提供公农历、节气与放假调休，Mac、iOS 与 Web 共享核心和界面",
  "keywords": [
    "iOS",
    "macOS",
    "农历",
    "日历",
    "节假日",
    "节气",
    "调休"
  ],
  "type": "module",
  "scripts": {
    "build": "pnpm run build:core && pnpm run build:web",
    "build:core": "pnpm --filter @shiri/calendar-core run build",
    "build:icons": "node scripts/build-icons.mjs",
    "build:ios": "node scripts/tauri.mjs ios build",
    "build:mac": "node scripts/package-tauri-mac.mjs",
    "build:web": "node scripts/license-notices.mjs --web && vite build --config apps/calendar/vite.config.ts",
    "check": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm test && pnpm run build",
    "check:mac": "node scripts/check-native.mjs --app",
    "check:native": "node scripts/check-native.mjs",
    "data:fetch": "tsx scripts/fetch-holidays.ts",
    "dev": "node scripts/license-notices.mjs --web && vite --config apps/calendar/vite.config.ts",
    "dev:ios": "node scripts/tauri.mjs ios dev",
    "dev:mac": "node scripts/tauri.mjs dev",
    "dev:web": "pnpm run dev",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "ios:init": "node scripts/tauri.mjs ios init --ci",
    "licenses:native": "node scripts/license-notices.mjs",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix .",
    "preview:web": "vite preview --config apps/calendar/vite.config.ts --host 127.0.0.1",
    "tauri": "node scripts/tauri.mjs",
    "test": "tsx --test packages/calendar-core/test/*.test.ts packages/calendar-ui/test/*.test.ts",
    "typecheck": "tsc --noEmit && pnpm --filter @shiri/calendar-core run typecheck"
  },
  "dependencies": {
    "@shiri/calendar-core": "workspace:*",
    "@shiri/calendar-ui": "workspace:*",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "^2",
    "@tauri-apps/plugin-opener": "2.7.3",
    "antd": "6.7.0",
    "lunar-typescript": "1.8.7",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.3.0",
    "autoprefixer": "^10",
    "esbuild": "^0.28.2",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "postcss": "^8",
    "tailwindcss": "3.4.19",
    "tsx": "^4.20.0",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=12.18.0 <13"
  },
  "packageManager": "pnpm@12.18.0"
}
