{
  "name": "shiri-calendar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build:core && npm run build:web && npm run build:apple-core",
    "build:core": "npm run build --workspace @shiri/calendar-core",
    "build:apple-core": "node scripts/bundle-apple-core.mjs",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace @shiri/calendar-core",
    "test": "tsx --test packages/calendar-core/test/*.test.ts packages/calendar-ui/test/*.test.ts",
    "data:fetch": "tsx scripts/fetch-holidays.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "build:mac": "node scripts/package-tauri-mac.mjs",
    "check:apple": "swift run --package-path platforms/apple CalendarSmoke",
    "dev": "node scripts/license-notices.mjs --web && vite --config apps/calendar/vite.config.ts",
    "dev:web": "npm run dev",
    "build:web": "node scripts/license-notices.mjs --web && vite build --config apps/calendar/vite.config.ts",
    "preview:web": "vite preview --config apps/calendar/vite.config.ts --host 127.0.0.1",
    "tauri": "node scripts/tauri.mjs",
    "dev:mac": "node scripts/tauri.mjs dev",
    "check:native": "node scripts/check-native.mjs",
    "check:mac": "node scripts/check-native.mjs --app",
    "ios:init": "node scripts/tauri.mjs ios init --ci",
    "dev:ios": "node scripts/tauri.mjs ios dev",
    "build:ios": "node scripts/tauri.mjs ios build",
    "licenses:native": "node scripts/license-notices.mjs"
  },
  "dependencies": {
    "@shiri/calendar-core": "0.1.0",
    "@shiri/calendar-ui": "0.1.0",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "^2",
    "@tauri-apps/plugin-opener": "2.7.3",
    "antd": "6.7.0",
    "lunar-typescript": "1.8.7",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.3.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.0",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  },
  "description": "拾日历：免费无广告的菜单栏日历，提供公农历、节气与放假调休，Mac、iOS 与 Web 共享核心和界面",
  "displayName": "拾日历",
  "keywords": [
    "日历",
    "农历",
    "节气",
    "节假日",
    "调休",
    "macOS",
    "iOS"
  ],
  "engines": {
    "node": ">=24"
  }
}
